{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta.example/schemas/process-graph-1.0.json",
  "title": "DELTA Canonical Process Graph",
  "type": "object",
  "required": ["schemaVersion", "processId", "title", "metadata", "actors", "nodes", "transitions", "decisions", "businessRules", "exceptions", "loops", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "processId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "required": ["domain", "difficulty", "tags"],
      "properties": {
        "domain": { "type": "string" },
        "difficulty": { "enum": ["simple", "intermediate", "complex", "enterprise", "real_world"] },
        "createdAt": { "type": "string" },
        "source": { "type": "string" },
        "model": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "businessRules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } },
    "loops": { "type": "array", "items": { "$ref": "#/$defs/loop" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["person", "role", "team", "department", "organization", "external_party", "system", "ai_agent"] },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name", "inputs", "outputs", "conditions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string" },
        "description": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "nodeId", "question", "options"],
      "properties": {
        "id": { "type": "string" },
        "nodeId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "description", "condition"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "type": "string" },
        "truePath": { "type": "string" },
        "falsePath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "handling": { "type": "string" },
        "nodeId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "required": ["id", "entryNodeId", "backNodeId", "description"],
      "properties": {
        "id": { "type": "string" },
        "entryNodeId": { "type": "string" },
        "backNodeId": { "type": "string" },
        "description": { "type": "string" },
        "condition": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "source", "quote"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "quote": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
