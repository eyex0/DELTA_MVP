# DELTA environment template
# Copy this file to .env (or .env.local for local dev) and replace all placeholder values.
# Never commit real secrets to the repository.

# Core app runtime
PORT=3100
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=2mb
JWT_SECRET=
AUTH_PROVIDER=entra
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3100/api/auth/entra/callback
DISABLE_DB=false

# AI provider selection: foundry or nvidia
AI_PROVIDER=foundry

# Microsoft Foundry
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
FOUNDRY_TIMEOUT_MS=30000

# NVIDIA NIM (OpenAI-compatible; use when AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
NVIDIA_TIMEOUT_MS=30000

# PostgreSQL / Drizzle
DATABASE_URL=
DIRECT_DATABASE_URL=
# Backward-compatible alias accepted by the migration tool.
DIRECT_URL=
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Worker / queue
WORKER_ID=agent-worker-1

# Optional legacy integration settings. Neon is the authoritative application
# database and authentication is handled by DELTA or Entra.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
STORAGE_BUCKET=
REDIS_URL=
APP_URL=http://localhost:5173
API_URL=http://localhost:3100

# Optional Vite config
BASE_PATH=/
