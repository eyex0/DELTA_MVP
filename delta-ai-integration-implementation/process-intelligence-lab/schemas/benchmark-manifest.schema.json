{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta.example/schemas/benchmark-manifest.schema.json",
  "title": "DELTA Process Intelligence Benchmark Manifest",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "domain", "difficulty", "split", "input", "gold", "expectedRelationships", "annotations"],
        "properties": {
          "id": { "type": "string", "pattern": "^B2-[0-9]{3}$" },
          "domain": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["simple", "intermediate", "complex", "enterprise"] },
          "split": { "enum": ["train", "validation", "test", "challenge"] },
          "input": { "type": "string", "minLength": 40 },
          "gold": { "$ref": "process.schema.json" },
          "expectedRelationships": { "type": "array", "minItems": 1 },
          "annotations": {
            "type": "object",
            "required": ["ambiguity", "assumptions", "qualityStatus", "reviewer"],
            "properties": {
              "ambiguity": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "assumptions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "qualityStatus": { "const": "reviewed" },
              "reviewer": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
