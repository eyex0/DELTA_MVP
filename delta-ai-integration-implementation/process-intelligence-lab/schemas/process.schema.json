{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta.example/schemas/process.schema.json",
  "title": "DELTA Canonical Process Graph",
  "type": "object",
  "required": ["schemaVersion", "processId", "title", "actors", "nodes", "transitions", "decisions", "businessRules", "exceptions", "loops", "metadata"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "processId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "businessRules": { "type": "array", "items": { "$ref": "#/$defs/businessRule" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } },
    "loops": { "type": "array", "items": { "$ref": "#/$defs/loop" } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["person", "role", "team", "department", "organization", "external_party", "system", "ai_agent"] }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "actorId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "type": "string" }
      },
      "decision": {
        "type": "object",
        "required": ["id", "nodeId", "question", "options"],
        "properties": {
          "id": { "type": "string" },
          "nodeId": { "type": "string" },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "evidence": {
        "type": "object",
        "required": ["id", "source", "quote"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "quote": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      },
      "additionalProperties": true
    },
    "businessRule": { "type": "object", "required": ["id", "description", "condition"], "additionalProperties": true },
    "exception": { "type": "object", "required": ["id", "name", "description"], "additionalProperties": true },
    "loop": { "type": "object", "required": ["id", "entryNodeId", "backNodeId", "description"], "additionalProperties": true }
  }
}
